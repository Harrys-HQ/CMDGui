{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CmdGUI",
  "version": "2.2.0",
  "identifier": "com.harrya.cmdgui",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npx vite",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CmdGUI",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5RkE1OTc0M0QwMTNDMEIKUldRTFBBRTlkRm42aVlMRzYwTWQ3cEpabFpScFR6VzYyaU1SVnVLRUgvQXd0SFZQRS9rckl1N1MK",
      "endpoints": [
        "https://github.com/Harrys-HQ/CMDGui/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "perMachine",
        "template": "installer.nsi",
        "languages": ["English"]
      }
    }
  }
}
